
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long a, b, c;
        cin >> a >> b >> c;

        long long sum = a + b + c;
        long long mx = max({a, b, c});
        long long mn = min({a, b, c});

        if (sum % 3 == 0 && mx - mn == 2) {
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }

    return 0;
}
