#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int a, b;
        cin >> a >> b;

        if (a == 0) {
            cout << (b <= 1 ? b : -1) << endl;
        } else if (b > a + 1) {
            cout << -1 << endl;
        } else if (b <= a && (a - b) % 2 == 0) {
            cout << a << endl;
        } else {
            cout << a + 1 << endl;
        }
    }

    return 0;
}
