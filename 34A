#include <bits/stdc++.h>
using namespace std;

int main() {
    int num;
    cin >> num;

    vector<int> h(num);
    for (int i = 0; i < num; i++)
        cin >> h[i];

    int minDiff = INT_MAX;
    int f = 0, s = 1;

    for (int i = 0; i < num; i++) {
        int next = (i + 1) % num;
        int diff = abs(h[i] - h[next]);

        if (diff < minDiff) {
            minDiff = diff;
            f = i;
            s = next;
        }
    }

    cout << f + 1 << " " << s + 1 << endl;

    return 0;
}

