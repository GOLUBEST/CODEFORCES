#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> p(n);
        for (int &x : p) cin >> x;

        vector<int> wrong;

        for (int i = 0; i < n; i++) {
            if (p[i] != i + 1) {
                wrong.push_back(i);
            }
        }

        bool possible = true;

        int left = 0, right = (int)wrong.size() - 1;

        while (left <= right) {
            int pos1 = wrong[left];
            int pos2 = wrong[right];

            if (p[pos1] != pos2 + 1 || p[pos2] != pos1 + 1) {
                possible = false;
                break;
            }

            left++;
            right--;
        }

        cout << (possible ? "YES\n" : "NO\n");
    }

    return 0;
}
