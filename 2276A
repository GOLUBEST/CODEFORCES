#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        long long a, b;
        cin >> a >> b;

        if (a <= b) {
            cout << -1 << endl;
        } else {
            cout << min(b, a - b) << endl;
        }
    }

    return 0;
}
