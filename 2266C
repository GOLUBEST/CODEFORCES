#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int num;
        cin >> num;

        string s;
        cin >> s;

        int zeros = 0;
        for (char c : s)
            zeros += (c == '0');

        if (s[0] == '1') {
            cout << zeros << endl;
            continue;
        }

        int ones = 0;
        int ans = num;

        for (int i = 0; i < num; i++) {
            ones += (s[i] == '1');
            zeros -= (s[i] == '0');
            ans = min(ans, ones + zeros);
        }

        cout << ans << endl;
    }

    return 0;
}
