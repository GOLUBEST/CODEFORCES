#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n + 1), L(n + 1), M(n + 1);

        for (int i = 1; i <= n; i++) {
            cin >> a[i];

            L[i] = L[i - 1] + (a[i] == 1 ? 1 : -1);
            M[i] = M[i - 1] + (a[i] == 3 ? -1 : 1);
        }

        vector<int> suf(n + 1, -1e9);

        suf[n - 1] = M[n - 1];

        for (int i = n - 2; i >= 1; i--)
            suf[i] = max(M[i], suf[i + 1]);

        bool ok = false;

        for (int i = 1; i <= n - 2; i++) {
            if (L[i] >= 0 && suf[i + 1] >= M[i]) {
                ok = true;
                break;
            }
        }

        cout << (ok ? "YES\n" : "NO\n");
    }
}
