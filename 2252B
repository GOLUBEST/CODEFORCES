#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;
        cin >> n >> s;

        int c0 = count(s.begin(), s.end(), '0');
        int c1 = n - c0;

        int dp[2][3];
        for (int i = 0; i < 2; i++)
            for (int j = 0; j < 3; j++)
                dp[i][j] = -1;

        int best[3] = {0, -1, -1};

        for (char ch : s) {
            int x = ch - '0';

            int ndp[2][3];
            memcpy(ndp, dp, sizeof(dp));

            int diff = (x == 0 ? 1 : -1);
            ndp[x][diff + 1] =
                max(ndp[x][diff + 1], 1);

            for (int last = 0; last < 2; last++) {
                if (last == x) continue;

                for (int d = -1; d <= 1; d++) {
                    if (dp[last][d + 1] == -1) continue;

                    int newDiff = d + (x == 0 ? 1 : -1);

                    if (newDiff >= -1 && newDiff <= 1) {
                        ndp[x][newDiff + 1] =
                            max(ndp[x][newDiff + 1],
                                dp[last][d + 1] + 1);
                    }
                }
            }

            memcpy(dp, ndp, sizeof(dp));
        }

        for (int d = -1; d <= 1; d++) {
            best[d + 1] = 0;

            for (int last = 0; last < 2; last++) {
                best[d + 1] =
                    max(best[d + 1], dp[last][d + 1]);
            }
        }

        int ans = INT_MAX;

        // d = r0 - r1
        for (int d = -1; d <= 1; d++) {
            int len = best[d + 1];

            if (len == 0) continue;

            int r0 = (len + d) / 2;
            int r1 = len - r0;

            int del0 = c0 - r0;
            int del1 = c1 - r1;

            if (del0 < 0 || del1 < 0)
                continue;

            if (abs(del0 - del1) <= 1) {
                ans = min(ans, del0 + del1);
            }
        }

        cout << (ans == INT_MAX ? -1 : ans) << '\n';
    }

    return 0;
}
