#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int num;
        char c;
        cin >> num >> c;

        string s;
        cin >> s;

        int coins = 0;

        for (int i = 0; i < num / 2; ++i) {
            int j = num - 1 - i;

            if (s[i] == s[j])
                continue;

            if (s[i] == c || s[j] == c)
                coins += 1;
            else
                coins += 2;
        }

        cout << coins << '\n';
    }

    return 0;
}
