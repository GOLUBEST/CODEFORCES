#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        vector<int> ones, neg;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            if (a[i] == 1) ones.push_back(i);
            if (a[i] == -1) neg.push_back(i);
        }

        if (ones.empty()) {
            if (neg.size() == 1) {
                a[neg[0]] = 1;
            } else if (neg.size() >= 2) {
                a[neg.front()] = 1;
                a[neg.back()] = 1;
            }

            for (int i = 0; i < n; i++) {
                if (a[i] == -1)
                    a[i] = 0;
            }
        } else {
            int bestL = ones[0];
            int bestR = ones[0];
            int bestLen = 1;

            for (int i = 1; i < (int)ones.size(); i++) {
                int len = ones[i] - ones[i - 1] + 1;

                if (len > bestLen) {
                    bestLen = len;
                    bestL = ones[i - 1];
                    bestR = ones[i];
                }
            }

            int firstOne = ones.front();
            int lastOne = ones.back();

            for (int x : neg) {
                if (x < firstOne) {
                    int len = firstOne - x + 1;

                    if (len > bestLen) {
                        bestLen = len;
                        bestL = x;
                        bestR = firstOne;
                    }
                }

                if (x > lastOne) {
                    int len = x - lastOne + 1;

                    if (len > bestLen) {
                        bestLen = len;
                        bestL = lastOne;
                        bestR = x;
                    }
                }
            }

            for (int i = 0; i < n; i++) {
                if (a[i] == -1)
                    a[i] = 0;
            }

            a[bestL] = 1;
            a[bestR] = 1;
        }

        for (int i = 0; i < n; i++) {
            cout << a[i] << (i + 1 == n ? '\n' : ' ');
        }
    }

    return 0;
}
