#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        vector<int> ones;

        for (int i = 0; i < n; ++i) {
            cin >> a[i];
            if (a[i] == 1)
                ones.push_back(i);
        }

        int L = -1, R = -1;

        if (ones.empty()) {
            int first = -1, last = -1;

            for (int i = 0; i < n; ++i) {
                if (a[i] == -1) {
                    if (first == -1)
                        first = i;
                    last = i;
                }
            }

            if (first != -1 && last != -1 && first != last) {
                L = first;
                R = last;
            }
        } else {
            int best = 0;

            for (int i = 0; i + 1 < (int)ones.size(); ++i) {
                int len = ones[i + 1] - ones[i] + 1;

                if (len > best) {
                    best = len;
                    L = ones[i];
                    R = ones[i + 1];
                }
            }

            int firstOne = ones.front();
            for (int i = 0; i < firstOne; ++i) {
                if (a[i] == -1) {
                    int len = firstOne - i + 1;

                    if (len > best) {
                        best = len;
                        L = i;
                        R = firstOne;
                    }
                }
            }

            int lastOne = ones.back();
            for (int i = lastOne + 1; i < n; ++i) {
                if (a[i] == -1) {
                    int len = i - lastOne + 1;

                    if (len > best) {
                        best = len;
                        L = lastOne;
                        R = i;
                    }
                }
            }
        }

        for (int i = 0; i < n; ++i) {
            if (a[i] == -1)
                a[i] = 0;
        }

        if (L != -1) {
            a[L] = 1;
            a[R] = 1;
        }

        for (int i = 0; i < n; ++i) {
            cout << a[i] << (i + 1 == n ? '\n' : ' ');
        }
    }

    return 0;
}
