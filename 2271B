#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n;
        cin >> n;

        vector<long long> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        long long ans = a[0];
        long long low = a[0], high = a[0];

        for (int i = 1; i < n; i++) {
            long long mx = max(abs(low), abs(high));
            ans = max(ans, a[i] + mx);

            long long nH = a[i] + max(0LL, 2LL * high);
            long long nL = a[i] + min(0LL, 2LL * low);

            high = nH;
            low = nL;
        }

        cout << ans << endl;
    }

    return 0;
}
