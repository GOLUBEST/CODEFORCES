#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    for (int ti = 0; ti < t; ti++) {
        string s;
        cin >> s;

        int n = s.size();
        int runs = 1;
        
        for (int i = 1; i < n; i++) {
            if (s[i] != s[i - 1]) {
                runs++;
            }
        }

        bool canIncrease = false;
        bool canDecrease = false;

        for (int i = 1; i < n - 1; i++) {

            if (s[i - 1] == s[i] &&
                s[i] == s[i + 1]) {
                canIncrease = true;
            }

            if (s[i - 1] == s[i + 1] &&
                s[i] != s[i - 1]) {
                canDecrease = true;
            }
        }

        int answer = 1;

        if (canIncrease) {
            answer++;
        }

        if (canDecrease) {
            answer++;
        }

        cout << answer << endl;
    }

    return 0;
}
