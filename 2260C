#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int qrTNum;
    cin >> qrTNum;

    while (qrTNum--) {
        long long x, y;
        cin >> x >> y;

        long long s = x + y;
        long long a = x;

        for (int i = 28; i >= 0; --i) {
            if ((x >> i & 1) && !(s >> i & 1)) {
                a = (x >> (i + 1)) << (i + 1);
                a |= s & ((1LL << (i + 1)) - 1);
                break;
            }
        }

        cout << s << ' ' << x - a << '\n';
    }

    return 0;
}
