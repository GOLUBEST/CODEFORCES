#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int n, q;
        cin >> n >> q;

        vector<int> a(n + 1);
        int ans = 0;

        for (int i = 1; i <= n; ++i) {
            cin >> a[i];

            if (__builtin_popcount(a[i]) % 2 == 0)
                ++ans;
        }

        cout << ans << ' ';

        while (q--) {
            int p, x;
            cin >> p >> x;

            if (__builtin_popcount(a[p]) % 2 == 0)
                --ans;

            a[p] = x;

            if (__builtin_popcount(a[p]) % 2 == 0)
                ++ans;

            cout << ans << ' ';
        }

        cout << '\n';
    }

    return 0;
}
