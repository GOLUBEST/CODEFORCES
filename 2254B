#include<bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        int groups = 1;
        for(int i = 1; i < n; i++) {
            if(s[i] != s[i - 1])
                groups++;
        }

        int ans = groups;

        for(int i = 1; i <= n - 2; i++) {

            int reduction = 0;

            if(s[i - 1] == s[i + 1] && s[i] != s[i - 1]) {
                reduction = 2;
            }
            else if(s[i] != s[i - 1] && s[i] != s[i + 1]) {
                reduction = 1;
            }

            ans = min(ans, groups - reduction);
        }

        cout << ans << endl;
    }

    return 0;
}
