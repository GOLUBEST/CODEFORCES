
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n, k;
        cin >> n >> k;

        vector<int> freq(n + 1, 0);

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            freq[x]++;
        }

        int available = 0;
        int ans = 0;

        for (int x = 0; x <= n; x++) {
            available += freq[x];

            if (freq[x] == 0 || available < k) {
                break;
            }

            available -= k;
            ans++;
        }

        cout << ans << endl;
    }

    return 0;
}
