#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n;
        cin >> n;

        int d = 1;
        while (d <= n) d <<= 1;

        int k = 2 * d - 1;
        cout << k << endl;

        for (int i = 1; i <= k; i++) {
            int p = (i - 1) % d;
            int q = i % d;

            int prev = p ^ (p >> 1);
            int cur = q ^ (q >> 1);

            cout << (prev ^ cur) << (i == k ? "" : " ");
        }
        cout << endl;
    }

    return 0;
}
