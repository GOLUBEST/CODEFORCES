#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n, k;
        cin >> n >> k;

        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        vector<int> rem(n + 1, 0);

        for (int i = 1; i <= n; i++) {
            rem[i] = (rem[i - 1] + a[i - 1] % k) % k;
        }

        vector<long long> freq(k, 0);
        long long ans = 0;

        for (int i = 0; i <= n; i++) {
            int j = i - k - 1;

            if (j >= 0) {
                freq[rem[j]]++;
            }

            ans += freq[rem[i]];
        }

        cout << ans << endl;
    }

    return 0;
}
