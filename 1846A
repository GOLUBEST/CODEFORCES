
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n;
        cin >> n;

        int ans = 0;

        for (int i = 0; i < n; i++) {
            int h, l;
            cin >> h >> l;

            if (h > l) {
                ans++;
            }
        }

        cout << ans << endl;
    }

    return 0;
}
