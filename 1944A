
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        int ans = n;

        for (int x = 1; x <= n; x++) {
            if (1LL * x * (n - x) <= k) {
                ans = x;
                break;
            }
        }

        cout << ans << endl;
    }

    return 0;
}
