
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<int> h(n);

    for (int i = 0; i < n; i++) {
        cin >> h[i];
    }

    sort(h.begin(), h.end());

    vector<int> left, mid, right;

    for (int i = 0; i < n; ) {
        int j = i;

        while (j < n && h[j] == h[i]) {
            j++;
        }

        int cnt = j - i;

        left.push_back(h[i]);

        if (cnt >= 2) {
            right.push_back(h[i]);
        }

        for (int k = 2; k < cnt; k++) {
            mid.push_back(h[i]);
        }

        i = j;
    }

    reverse(right.begin(), right.end());

    int ans = left.size() + right.size();

    cout << ans << endl;

    for (int x : left) {
        cout << x << " ";
    }

    for (int x : mid) {
        cout << x << " ";
    }

    for (int x : right) {
        cout << x << " ";
    }

    cout << endl;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
