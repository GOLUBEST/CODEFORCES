#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> freq(26, 0);

        for (int i = 0; i < n; i++) {
            string s;
            cin >> s;

            for (char c : s) {
                freq[c - 'a']++;
            }
        }

        bool possible = true;

        for (int x : freq) {
            if (x % n != 0) {
                possible = false;
                break;
            }
        }

        cout << (possible ? "YES" : "NO") << endl;
    }

    return 0;
}
