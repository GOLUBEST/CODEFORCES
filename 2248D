#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int n, q;
        cin >> n >> q;

        string s, t;
        cin >> s >> t;

        vector<array<int, 4>> pref(n + 1);

        for (int i = 1; i <= n; ++i) {
            pref[i] = pref[i - 1];

            int x = (s[i - 1] - '0') * 2 + (t[i - 1] - '0');

            if (x == 0) ++pref[i][0];
            else if (x == 3) ++pref[i][1];
            else if (x == 1) ++pref[i][2];
            else ++pref[i][3];
        }

        while (q--) {
            int l, r;
            cin >> l >> r;

            int a = pref[r][0] - pref[l - 1][0];
            int b = pref[r][1] - pref[l - 1][1];
            int c = pref[r][2] - pref[l - 1][2];
            int d = pref[r][3] - pref[l - 1][3];

            cout << (abs(c - d) <= a + b ? "YES\n" : "NO\n");
        }
    }

    return 0;
}
