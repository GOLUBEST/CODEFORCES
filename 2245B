#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        long long c;
        cin >> n >> c;

        vector<long long> a(n);
        long long ans = 0;

        for (auto &x : a) {
            cin >> x;
            ans += x - c;
        }

        sort(a.begin(), a.end());

        int pairs = 0;

        for (int i = 0; i < n && pairs < n / 2; ++i) {
            if (a[i] >= c)
                break;

            ans += c - a[i];
            ++pairs;
        }

        cout << ans << '\n';
    }

    return 0;
}
