
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<int> b(n);
    for (int i = 0; i < n; i++) {
        cin >> b[i];
    }

    vector<int> a;
    a.push_back(b[0]);

    for (int i = 1; i < n; i++) {
        if (b[i - 1] > b[i]) {
            a.push_back(b[i]);
        }

        a.push_back(b[i]);
    }

    cout << a.size() << endl;

    for (int x : a) {
        cout << x << " ";
    }
    cout << endl;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
