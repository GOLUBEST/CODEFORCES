#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int maxValidSubsequence(vector<array<int, 4>>& a) {
        int n = a.size();

        auto can = [&](int m) {
            int pos = 1;

            for (int i = 0; i < n && pos <= m; i++) {
                int l = a[i][0], r = a[i][1];
                int u = a[i][2], v = a[i][3];

                int rightRank = m - pos + 1;

                bool badLeft = (l <= pos && pos <= r);
                bool badRight = (u <= rightRank && rightRank <= v);

                if (!badLeft && !badRight) {
                    pos++;
                }
            }

            return pos > m;
        };

        int ans = 0;

        // Feasibility is not monotonic, so check every possible length.
        for (int m = 1; m <= n; m++) {
            if (can(m)) {
                ans = m;
            }
        }

        return ans;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<array<int, 4>> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i][0] >> a[i][1] >> a[i][2] >> a[i][3];
        }

        Solution sol;
        cout << sol.maxValidSubsequence(a) << '\n';
    }

    return 0;
}
