
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;

    vector<long long> sum(k + 1, 0);

    for (int i = 0; i < k; i++) {
        int b, c;
        cin >> b >> c;

        sum[b] += c;
    }

    vector<long long> totals;

    for (int i = 1; i <= k; i++) {
        if (sum[i] > 0) {
            totals.push_back(sum[i]);
        }
    }

    sort(totals.rbegin(), totals.rend());

    long long ans = 0;

    for (int i = 0; i < min(n, (int)totals.size()); i++) {
        ans += totals[i];
    }

    cout << ans << endl;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
