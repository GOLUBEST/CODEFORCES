
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;

    vector<long long> a(n);

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    sort(a.begin(), a.end());

    int cnt = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] == a[n - 1]) {
            cnt++;
        }
    }

    if (cnt > k) {
        cout << "NO\n";
        return;
    }

    cout << "YES\n";

    // First, print the largest k elements in ascending order.
    for (int i = n - k; i < n; i++) {
        cout << a[i] << " ";
    }

    // Then, print the remaining elements in descending order.
    for (int i = n - k - 1; i >= 0; i--) {
        cout << a[i] << " ";
    }

    cout << "\n";
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
