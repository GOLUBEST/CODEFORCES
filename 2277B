#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int ti;
    cin >> ti;

    while (ti--) {
        int n;
        cin >> n;

        int mn = INT_MAX;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            mn = min(mn, x);
        }

        if (mn < n) {
            cout << n << endl;
        } else {
            cout << 0 << endl;
        }
    }

    return 0;
}
