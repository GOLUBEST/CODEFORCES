
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, m;
    cin >> n >> m;

    string s, t;
    cin >> s >> t;

    int freq[26] = {0};

    for (char ch : s) {
        freq[ch - 'a']++;
    }

    for (char ch : t) {
        freq[ch - 'a']--;
    }

    string target = "six";

    for (char ch : target) {
        freq[ch - 'a']--;
    }

    for (int i = 0; i < 26; i++) {
        if (freq[i] != 0) {
            cout << "NO" << endl;
            return;
        }
    }

    cout << "YES" << endl;
}

int main() {
    int ti;
    cin >> ti;

    while (ti--) {
        solve();
    }

    return 0;
}
